<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>3.0.0</Version>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Lisp</RootNamespace>
    <AssemblyName>Lisp</AssemblyName>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <AppConfig>app.config</AppConfig>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591;NU1902</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Lisp</PackageId>
    <Title>Lisp Scheme interpreter for .NET</Title>
    <Description>A practical Scheme interpreter for .NET with a bytecode VM, standard library, macros, and .NET interoperability.</Description>
    <Authors>ilias</Authors>
    <PackageTags>scheme;lisp;interpreter;dotnet;embedding</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ilias/Lisp</RepositoryUrl>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="" />
    <None Update="docs\embedding.md" Pack="true" PackagePath="docs" />
    <Compile Remove="Lisp.Tests\**" />
    <None Remove="Lisp.Tests\**" />
    <Compile Remove="Lisp.Web\**" />
    <None Remove="Lisp.Web\**" />
    <None Include="app.config" />
    <Content Include="App.ico" />
    <Content Include="init.ss">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="lib\*.ss">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="examples.ss">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tests.ss">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ReadLine" Version="2.0.1" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>
</Project>
